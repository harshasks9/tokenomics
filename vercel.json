{
  "crons": [
    {
      "path": "/api/options/cron",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/brief/cron",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "strategy.aitokenomics.app"
        }
      ],
      "destination": "/strategy/:path*"
    }
  ]
}
