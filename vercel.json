{
  "crons": [
    {
      "path": "/api/brief/cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/options/cron",
      "schedule": "30 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "strategy.aitokenomics.app"
        }
      ],
      "destination": "/strategy/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "agentic.aitokenomics.app"
        }
      ],
      "destination": "/agentic/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "voice.aitokenomics.app"
        }
      ],
      "destination": "/voice/:path*"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "offers.aitokenomics.app"
        }
      ],
      "destination": "/offers/robots.txt"
    }
  ]
}
