# ── AI Daily Brief (/brief) ──────────────────────────────────────────────
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey) —
# required for live briefs (sources fetched via the url_context tool, which is
# available on the free tier). Without it the app serves clearly-labeled mock
# sample data. GOOGLE_API_KEY is accepted as an alternative name.
GEMINI_API_KEY=

# Optional: override the Gemini model used for generation (default: gemini-3.5-flash).
BRIEF_GEMINI_MODEL=

# Optional: comma-separated URLs to replace the default curated news sources.
BRIEF_SOURCES=

# Bearer token Vercel cron sends to /api/brief/cron (required in production).
CRON_SECRET=

# Durable storage for daily briefs (Upstash / Vercel KV REST API).
# Optional locally (falls back to data/briefs/*.json), recommended in prod.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Offers (/offers · offers.aitokenomics.app) ───────────────────────────
# Shared passcode for the internal pricing simulator. Server-side only —
# never expose as NEXT_PUBLIC_. Rotate quarterly or on team change; see
# docs/offers.md. Without both of these set, the gate stays closed.
SITE_PASSCODE=

# Random 32+ bytes, signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every outstanding session immediately.
SESSION_SECRET=
